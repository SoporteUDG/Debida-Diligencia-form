// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum AdminRole {
  SUPERADMIN
  ADMIN
  USER
}

enum FormType {
  NATURAL
  JURIDICA
}

enum FormStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

enum TokenType {
  ACCESS
  VERIFICATION
  PASSWORD_RESET
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Rol de un enlace (Draft) o formulario (Form) dentro de un expediente:
// - PRINCIPAL: el del contacto estándar (Contacto_est_ndar); es el único que
//   se vincula y sincroniza con el registro de Debida_Diligencia de Zoho.
// - RELATED: el de otro contacto del Socio de Negocio, sobre el mismo expediente.
// - ADITIONAL: los enlaces adicionales generados desde Zoho (generar-adicional).
// RELATED y ADITIONAL llevan isAditional = true: no escriben en el registro de Zoho.
enum LinkRole {
  PRINCIPAL
  RELATED
  ADITIONAL
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

// ==========================================
// MODELS
// ==========================================

// 1. AdminUser
model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  auditLogs    AuditLog[]

  @@index([email])
  @@index([deletedAt])
}

// 2. CrmContact
model CrmContact {
  id                 String                  @id @default(uuid())
  crmId              String                  @unique
  firstName          String
  lastName           String
  email              String
  phone              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  // Socio de Negocio (Accounts) al que pertenece el expediente (Socio_de_Negocios)
  accountCrmId       String?
  // Identificador que genera el navegador al enviar /registro/*: un reintento no duplica el expediente en Zoho
  submissionId       String?                 @unique
  // Contacto de Zoho (Contacts) cuyos datos personales actualiza este expediente
  accountContactId   String?
  accountContact     AccountContact?         @relation(fields: [accountContactId], references: [id], onDelete: SetNull)
  // Anulación (archivo) de un expediente ya enviado; reactivable. Ver ddRetireService.
  retiredAt              DateTime?
  retiredReason          String?   @db.Text
  retiredBy              String?
  // Carpeta del expediente en WorkDrive y la carpeta donde estaba, para devolverla al reactivar
  retiredFolderId        String?
  retiredOriginFolderId  String?
  // Contacto faltante: su Contact ya no existe en el Socio de Negocio de Zoho (enlace desactivado, nota en Zoho)
  missingContactAt       DateTime?
  forms              Form[]
  tokens             Token[]
  drafts             Draft[]
  editAuthorizations FormEditAuthorization[]

  @@index([crmId])
  @@index([email])
  @@index([deletedAt])
  @@index([accountCrmId])
  @@index([accountContactId])
}

// 2.1 AccountContact (Contactos de Zoho vinculados a un Socio de Negocio)
//
// Copia local de los Contacts de Zoho CRM vinculados a un Account. Un Account de
// Persona Natural puede tener varios; uno de Persona Jurídica solo uno (se
// valida al crear en accountContactService, no en el esquema). Cada expediente
// (CrmContact) enlaza con exactamente un contacto: al completarse el formulario
// se actualizan ese contacto y el expediente de Debida_Diligencia.
model AccountContact {
  id            String       @id @default(uuid())
  crmId         String       @unique // ID del Contact en Zoho CRM
  accountCrmId  String // ID del Account (Socio de Negocio) en Zoho CRM
  firstName     String       @default("")
  lastName      String       @default("")
  email         String?
  phone         String?
  zohoCreatedAt DateTime? // Created_Time en Zoho: define el más antiguo
  // Contacto_est_ndar en Zoho: contacto principal del Socio de Negocio (Persona Natural)
  isStandard    Boolean      @default(false)
  // Marca: el contacto ya no existe en Zoho (se detectó al generar expedientes). No borra nada.
  missingInZohoAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  crmContacts   CrmContact[]
  drafts        Draft[]
  forms         Form[]

  @@index([accountCrmId])
  @@index([deletedAt])
}

// 3. Form (Formulario)
model Form {
  id                       String      @id @default(uuid())
  type                     FormType
  status                   FormStatus  @default(SUBMITTED)
  clientName               String
  projectName              String
  crmContactId             String?
  crmContact               CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  data                     Json // Payload completo de FormState (JSONB) - siempre la versión vigente
  conclusionesVerificacion String?     @db.Text
  submittedAt              DateTime?   @default(now())
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  deletedAt                DateTime?

  // Número de la versión vigente. Cada reenvío autorizado lo incrementa.
  currentVersion Int @default(1)

  // Expediente adicional: comparte el CrmContact (DD de Zoho) pero su información
  // de cliente no se vincula ni se sincroniza con Zoho CRM.
  isAditional Boolean @default(false)

  // Rol del formulario en el expediente (ver LinkRole). isAditional = role != PRINCIPAL.
  role             LinkRole        @default(PRINCIPAL)
  // Contacto relacionado (role RELATED) que llenó el formulario
  accountContactId String?
  accountContact   AccountContact? @relation(fields: [accountContactId], references: [id], onDelete: SetNull)

  // Token (enlace) con el que se envió el formulario: permite ubicar el expediente
  // al reactivar un enlace adicional en concreto (ver /api/reactivar).
  tokenUuid String?

  // Anulación (archivo) de un formulario adicional ya enviado. Ver adicionalRetireService.
  retiredAt             DateTime?
  retiredReason         String?   @db.Text
  retiredBy             String?
  retiredFolderId       String?
  retiredOriginFolderId String?

  // Relaciones hijas (Cascade onDelete)
  gjcMembers          GjcMember[]
  bfMembers           BfMember[]
  legalRepresentative LegalRepresentative?
  signature           Signature?
  documents           Document[]
  crmSync             CrmSync?
  workDriveSync       WorkDriveSync?
  sapSync             SapSync?
  versions            FormVersion[]
  editAuthorizations  FormEditAuthorization[]

  @@index([status])
  @@index([crmContactId])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([tokenUuid])
  @@index([accountContactId])
}

// 3.1 FormVersion (Historial de versiones del expediente)
//
// Cada envío sella una fila inmutable con el FormState completo. La v1 es el
// envío original; cada reenvío autorizado mediante "Reactivar Enlace" agrega
// una versión nueva. Form.data siempre refleja la versión vigente.
model FormVersion {
  id          String     @id @default(uuid())
  formId      String
  form        Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  version     Int
  data        Json // Snapshot íntegro del FormState en esta versión
  status      FormStatus @default(SUBMITTED)
  clientName  String
  projectName String

  // Responsable del cambio. En la v1 quedan nulos: nadie autorizó el envío
  // original, es el expediente inicial del cliente.
  authorizationId String?
  authorization   FormEditAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  authorizedBy    String? // Usuario de Zoho que pulsó "Reactivar Enlace"
  reason          String?                @db.Text // Motivo declarado de la modificación

  // Campos de primer nivel que cambiaron respecto de la versión anterior.
  // Es un apoyo para la vista de auditoría; el dato autoritativo es `data`.
  changedFields String[] @default([])

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([formId, version])
  @@index([formId])
  @@index([authorizedBy])
}

// 3.2 FormEditAuthorization (Permiso para modificar un expediente ya enviado)
//
// Un expediente enviado queda bloqueado. "Reactivar Enlace" en Zoho CRM crea
// una autorización pendiente que habilita exactamente UNA modificación; al
// sellarse la versión nueva la autorización se marca como consumida.
// Las autorizaciones sin consumir dejan constancia de reactivaciones que nunca
// derivaron en un cambio.
model FormEditAuthorization {
  id           String     @id @default(uuid())
  formId       String?
  form         Form?      @relation(fields: [formId], references: [id], onDelete: Cascade)
  crmContactId String
  crmContact   CrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)
  tokenUuid    String? // Token reactivado con el que se autorizó la edición

  authorizedBy String // Quién autorizó (usuario de Zoho CRM)
  reason       String? @db.Text
  source       String  @default("ZOHO_REACTIVAR") // Origen de la autorización

  expiresAt           DateTime // Coincide con la nueva vigencia del enlace
  consumedAt          DateTime? // Se sella al crear la versión
  consumedByVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FormVersion[]

  @@index([crmContactId])
  @@index([formId])
  @@index([consumedAt])
  @@index([tokenUuid])
}

// 4. Token
model Token {
  id              String     @id @default(uuid())
  token           String     @unique
  type            TokenType
  crmContactId    String
  crmContact      CrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)
  used            Boolean    @default(false)
  expirationNoted Boolean    @default(false)
  expiresAt       DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([token])
  @@index([crmContactId])
  @@index([expiresAt])
}

// 5. Draft (Borrador JSONB)
model Draft {
  id           String      @id @default(uuid())
  type         FormType
  data         Json // Progreso temporal del FormState
  step         Int         @default(1)
  token        String      @unique
  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  expiresAt    DateTime?
  documents    Document[]

  // Borrador de un expediente adicional (ver Form.isAditional)
  isAditional Boolean @default(false)

  // Rol del enlace en el expediente (ver LinkRole). isAditional = role != PRINCIPAL.
  role             LinkRole        @default(PRINCIPAL)
  // Contacto relacionado (role RELATED) al que pertenece el enlace
  accountContactId String?
  accountContact   AccountContact? @relation(fields: [accountContactId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([crmContactId])
  @@index([accountContactId])
}

// 6. Document
model Document {
  id         String         @id @default(uuid())
  formId     String?
  form       Form?          @relation(fields: [formId], references: [id], onDelete: Cascade)
  draftId    String?
  draft      Draft?         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  name       String
  fileType   String
  url        String         @db.Text // URL en almacenamiento/WorkDrive
  zohoFileId String?        @db.Text // Identificador de archivo en Zoho WorkDrive
  status     DocumentStatus @default(PENDING)
  comments   String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  // Document "slot" identity (e.g. "copiaIdFile") - previously only encoded in `name`
  documentType String?

  // Attribution to a specific dynamic person, when applicable.
  // personId matches GjcMember.id / BfMember.id (client-generated UUIDs, preserved
  // through submission - see submit/route.ts), or the literal "rl" for the legal rep.
  personType String? // "GJC" | "BF" | "RL"
  personId   String?

  @@index([formId])
  @@index([draftId])
  @@index([draftId, documentType, personType, personId])
}

// 7. GjcMember (Gobierno y Junta Directiva)
model GjcMember {
  id              String    @id @default(uuid())
  formId          String
  form            Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  cargo           String
  nombre          String
  apellidos       String
  nacionalidad    String
  fechaNacimiento DateTime?
  nroId           String
  direccion       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([formId])
}

// 8. BfMember (Beneficiarios Finales)
model BfMember {
  id                      String    @id @default(uuid())
  formId                  String
  form                    Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  nombreCompleto          String
  noIdentificacion        String
  nacionalidad            String
  fechaAdquisicion        DateTime?
  porcentajeParticipacion String? // Guardado como texto para soportar rangos o valores ingresados
  paisNacimiento          String
  direccion               String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([formId])
}

// 9. LegalRepresentative (Representante Legal)
model LegalRepresentative {
  id                  String    @id @default(uuid())
  formId              String    @unique
  form                Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  nombre              String
  fechaNacimiento     DateTime?
  nacionalidad        String
  noIdentificacion    String
  profesionOcupacion  String?
  actividadEconomica  String?
  direccion           String?   @db.Text
  paisResidencia      String?
  telefono            String?
  objetoInvestigacion String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// 10. Signature (Firma)
model Signature {
  id            String   @id @default(uuid())
  formId        String   @unique
  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  signerName    String
  signatureDate DateTime
  firmaImage    String   @db.Text // Base64 de la firma
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 11. CrmSync
model CrmSync {
  id           String     @id @default(uuid())
  formId       String     @unique
  form         Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  status       SyncStatus @default(PENDING)
  crmId        String?
  attempts     Int        @default(0)
  lastAttempt  DateTime?
  errorMessage String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

// 12. WorkDriveSync
model WorkDriveSync {
  id            String     @id @default(uuid())
  formId        String     @unique
  form          Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  status        SyncStatus @default(PENDING)
  folderUrl     String?    @db.Text
  // Versión del expediente ya consolidada en WorkDrive. Una enmienda deja este
  // valor por debajo de Form.currentVersion y obliga a regenerar el PDF.
  syncedVersion Int?
  attempts      Int        @default(0)
  lastAttempt   DateTime?
  errorMessage  String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
}

// 13. SapSync
model SapSync {
  id           String     @id @default(uuid())
  formId       String     @unique
  form         Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  status       SyncStatus @default(PENDING)
  sapCardCode  String?
  attempts     Int        @default(0)
  lastAttempt  DateTime?
  errorMessage String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

// 14. AuditLog (Registro de Auditoría / Logs)
model AuditLog {
  id         String     @id @default(uuid())
  action     String // Ejemplo: "USER_LOGIN", "FORM_SUBMIT", "FORM_APPROVE", "DOCUMENT_UPLOAD"
  entityName String // Ejemplo: "Form", "Document", "AdminUser"
  entityId   String?
  details    Json? // Metadatos adicionales de la auditoría en formato JSON
  ipAddress  String?
  userAgent  String?
  userId     String?
  adminUser  AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entityName, entityId])
}

// Última copia conocida de los campos mapeados de un expediente en Zoho CRM.
// El webhook de cambios compara contra ella para saber qué campos se
// modificaron realmente en Zoho (el workflow solo avisa que hubo un cambio).
model ZohoRecordSnapshot {
  id        String   @id @default(uuid())
  crmId     String   @unique
  data      Json // { Campo_API: valor normalizado }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enlace temporal (botón "Generar temporal" del Canvas de Zoho): funciona como
// un Draft, pero solo con el primer paso del formulario (Identificación
// personal / Identificación de empresa). El token en claro solo viaja en el
// enlace; aquí se guarda su hash SHA-256. Ver temporalService y manageTemporal.
model Temporal {
  id          String    @id @default(uuid())
  type        FormType
  data        Json
  tokenHash   String    @unique
  // Token en claro (como Token.token), para volver a mostrar el enlace en el
  // widget de enlaces temporales. null en los temporales anteriores a la columna.
  token       String?
  // Registro de Zoho desde el que se generó (solo temporales antiguos, del
  // Canvas). Los nuevos salen de la vista de lista y no se atan a un registro.
  crmRecordId String?
  // Módulo de Zoho desde el que se generó
  crmModule   String
  // Usuario de Zoho que pulsó el botón
  createdBy   String?
  expiresAt   DateTime
  // Paso completado y entregado a manageTemporal; el enlace ya no se puede editar
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Enviados por el botón de Zoho: Name "nombre-unidad-proyecto" de lo que se crea
  unidadVendidaId     String?
  unidadVendidaNombre String?
  proyecto            String?

  // Registros de Zoho creados al enviarse (temporalScaffold). Cada id se guarda
  // al crearse: si la creación falla a medias, el reintento solo crea lo que falta.
  contactCrmId String? // Contact (solo natural; la jurídica no crea Contact)
  accountCrmId String? // Socio de Negocio (Accounts)
  ddCrmId      String? // Debida_Diligencia

  @@index([crmRecordId])
  @@index([expiresAt])
}
