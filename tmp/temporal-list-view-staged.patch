-  }
-  var unidadId = String(paso2[0] || "").trim();
-  var unidad = unidades.filter(function (u) { return String(u.id) === unidadId; })[0];
-  if (!unidad) {
-    ZDK.Client.showAlert("Seleccione la unidad.", TITULO);
