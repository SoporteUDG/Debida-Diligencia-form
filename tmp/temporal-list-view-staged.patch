-
-  ZDK.Client.showLoader({ type: "page", template: "vertical-bar", message: "Cargando unidades..." });
-  var lista = await portal("/unidades", { proyecto: proyecto });
-  ZDK.Client.hideLoader();
-  if (!lista.success) {
